# Native Windows CMake/Ninja driver for the installed devkitARM compiler.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR armv6k)
set(NINTENDO_3DS TRUE)
set(DEVKITPRO "C:/devkitPro" CACHE PATH "devkitPro root")
set(CMAKE_C_COMPILER "${DEVKITPRO}/devkitARM/bin/arm-none-eabi-gcc.exe")
set(CMAKE_CXX_COMPILER "${DEVKITPRO}/devkitARM/bin/arm-none-eabi-g++.exe")
set(CMAKE_AR "${DEVKITPRO}/devkitARM/bin/arm-none-eabi-ar.exe")
set(CMAKE_RANLIB "${DEVKITPRO}/devkitARM/bin/arm-none-eabi-ranlib.exe")
set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
set(CTR_FLAGS "-march=armv6k -mtune=mpcore -mfloat-abi=hard -mtp=soft -D__3DS__ -I${DEVKITPRO}/libctru/include")
set(CMAKE_C_FLAGS_INIT "${CTR_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${CTR_FLAGS}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-specs=3dsx.specs -L${DEVKITPRO}/libctru/lib")
set(CMAKE_C_STANDARD_LIBRARIES "-lctru -lm" CACHE STRING "" FORCE)
set(CMAKE_CXX_STANDARD_LIBRARIES "-lctru -lm" CACHE STRING "" FORCE)
set(CMAKE_FIND_ROOT_PATH "${DEVKITPRO}/portlibs/3ds;${DEVKITPRO}/libctru")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
